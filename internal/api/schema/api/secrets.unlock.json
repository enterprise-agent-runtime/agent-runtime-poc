{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.warden.dev/poc/api/secrets.unlock.json",
  "title": "secrets.unlock (NEW, docs/DECISIONS-poc.md D-010): unlock the encrypted-file secrets backend for the daemon's lifetime",
  "$defs": {
    "params": {
      "type": "object",
      "required": ["passphrase"],
      "additionalProperties": false,
      "properties": { "passphrase": { "type": "string", "minLength": 1, "maxLength": 1024 } }
    },
    "result": {
      "type": "object",
      "required": ["ok", "backend"],
      "properties": { "ok": { "const": true }, "backend": { "const": "file" }, "created": { "type": "boolean" } }
    }
  }
}
